{
  "component": "DashboardFilterBar",
  "sets": [
    {
      "set": "dashboard-filter-bar",
      "story": "components-dashboardfilterbar-showcase--figma",
      "background": "#ffffff",
      "accumulatedFallback": true,
      "hugNodes": [
        "**/chip-filter*",
        "**/segmented-control"
      ],
      "parts": {
        "Filters": ".ds-filter-bar__filters",
        "Filters/Controls*": ".ds-filter-bar__group",
        "Filters/Applied filters": ".ds-filter-bar__group",
        "Filters/Interval": ".ds-filter-bar__group",
        "Filters/*/Scope label": ".ds-filter-bar__label",
        "Filters/*/Label": ".ds-filter-bar__group > .ds-filter-bar__label",
        "Filters/*/Interval label": ".ds-filter-bar__label",
        "Filters/|*": ".ds-filter-bar__divider",
        "Filters/*/select/Container": ".ds-select__trigger",
        "Filters/*/select/Container/Input": ".ds-select__value",
        "Filters/Applied filters/chip-filter*": ".ds-chip",
        "Filters/Applied filters/chip-filter*/Label": ".ds-chip__label",
        "Filters/Controls#2/segmented-control": ".ds-segmented",
        "Filters/Controls#2/segmented-control/segmented-item*": ".ds-segmented__segment",
        "Filters/Controls#2/Date range": ".ds-filter-bar__range",
        "Filters/Controls#2/Date range/date-picker_trigger*/Container": ".ds-date-picker .ds-field__control",
        "Filters/Controls#2/Date range/To": ".ds-filter-bar__range-separator",
        "Actions": ".ds-filter-bar__actions",
        "Actions/button_basic": ".ds-filter-bar__actions .ds-button:not(.ds-icon-button)"
      },
      "pixelTolerance": {
        "firefox": 0.007,
        "webkit": 0.007
      },
      "//pixelTolerance": "without calc-size() each hugging label stays < 1px narrower, so the groups to the right move left (up to 3.25px at \"집계\") and their control borders differ: 0.60–0.61% (Chromium, with calc-size, ≤ 0.5%)"
    }
  ]
}
