{
  "component": "DatePicker",
  "sets": [
    {
      "set": "date-picker_message",
      "story": "components-datepicker-showcase--message-matrix",
      "background": "#ffffff",
      "harnessCss": "table { table-layout: fixed; } td, th { width: 120px; min-width: 120px; max-width: 120px; }",
      "parts": {
        "*-fill": ".ds-field-message__icon",
        "Info text": {
          "selector": ".ds-field-message__text",
          "optional": true
        },
        "* Text": {
          "selector": ".ds-field-message__text",
          "optional": true
        }
      }
    },
    {
      "set": "date-picker_calendar",
      "story": "components-calendar-showcase--calendar-matrix",
      "background": "#ffffff",
      "parts": {
        "Date Picker Header": ".ds-calendar__header",
        "Date Picker Header/Year and month": ".ds-calendar__selectors",
        "Date Picker Header/Year and month/date-picker_select*": ".ds-calendar__selectors .ds-text-button",
        "Date Picker Header/Year and month/date-picker_select*/button_text/Label": ".ds-calendar__selectors .ds-button__label",
        "Date Picker Header/navigation": ".ds-calendar__nav",
        "Date Picker Header/navigation/date-picker_navigation*": ".ds-calendar__nav-button",
        "Date Grid Container": ".ds-calendar__grid-wrap",
        "Date Grid Container/Weekday Row Container": {
          "selector": ".ds-calendar__grid thead tr",
          "compare": "yh"
        },
        "Date Grid Container/Weekday Row Container/weekday row*": {
          "selector": ".ds-calendar__weekday",
          "compare": "xyw"
        },
        "Date Grid Container/Date Row Container*": {
          "selector": ".ds-calendar__grid tbody tr",
          "compare": "yh"
        },
        "Date Grid Container/Date Row Container*/*": ".ds-calendar__day",
        "Date Grid Container/**/Day Number": {
          "selector": ".ds-calendar__day-number",
          "compare": "xyh"
        }
      },
      "//": "Calendar-only redesign: five Single/Range variants replace the removed input trigger baseline. All original pixel and glyph tolerances remain unchanged.",
      "waitFor": "[data-baseline-ready]"
    },
    {
      "set": "date-picker_day",
      "story": "components-calendar-showcase--day-matrix",
      "background": "#ffffff",
      "parts": {
        "Day Number": ".ds-calendar__day-label"
      }
    },
    {
      "set": "date-picker_navigation",
      "story": "components-calendar-showcase--navigation-matrix",
      "background": "#ffffff",
      "parts": {
        "caret-*": ".ds-calendar__nav-button > svg"
      }
    }
  ]
}
