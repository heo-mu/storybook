{
  "component": "DatePicker",
  "sets": [
    {
      "set": "date-picker_trigger",
      "story": "components-datepicker-showcase--variant-matrix",
      "background": "#ffffff",
      "harnessCss": "table { table-layout: fixed; } td, th { width: 344px; min-width: 344px; max-width: 344px; } tr > :first-child { width: 120px; min-width: 120px; max-width: 120px; }",
      "parts": {
        "Label": ".ds-field__label",
        "Container": ".ds-field__control",
        "Container/date": ".ds-field__input",
        "Container/calendar-dots": ".ds-date-picker__button",
        "date-picker_message": ".ds-field-message",
        "date-picker_message/*-fill": ".ds-field-message__icon",
        "date-picker_message/*ext": ".ds-field-message__text"
      },
      "glyphDxTolerance": 0.8,
      "//glyphDxTolerance": "Latin placeholder YYYY.MM.DD: the browser kerns the Y-Y pairs tighter than Figma, the run is ~1.3px shorter and its centroid moves -0.56..-0.77px (images otherwise identical)",
      "knownDifferences": {
        "Size=sm, State=Focus": "Figma shows the YYYY.MM.DD pattern; the story shows a real date (2026.07.30) — text box compared, glyphs not",
        "Size=sm, State=Completed": "same as Focus",
        "Size=sm, State=Error": "same as Focus",
        "Size=sm, State=Read-only": "same as Focus",
        "Size=md, State=Focus": "same as Focus",
        "Size=md, State=Completed": "same as Focus",
        "Size=md, State=Error": "same as Focus",
        "Size=md, State=Read-only": "same as Focus",
        "Size=lg, State=Focus": "same as Focus",
        "Size=lg, State=Completed": "same as Focus",
        "Size=lg, State=Error": "same as Focus",
        "Size=lg, State=Read-only": "same as Focus"
      }
    },
    {
      "set": "date-picker_message",
      "story": "components-datepicker-showcase--message-matrix",
      "background": "#ffffff",
      "harnessCss": "table { table-layout: fixed; } td, th { width: 120px; min-width: 120px; max-width: 120px; }",
      "parts": {
        "*-fill": ".ds-field-message__icon",
        "Info text": {
          "selector": ".ds-field-message__text",
          "optional": true
        },
        "* Text": {
          "selector": ".ds-field-message__text",
          "optional": true
        }
      }
    },
    {
      "set": "date-picker_calendar",
      "story": "components-calendar-showcase--calendar-matrix",
      "background": "#ffffff",
      "parts": {
        "Date Picker Header": ".ds-calendar__header",
        "Date Picker Header/header label": ".ds-calendar__title",
        "Date Picker Header/navigation": ".ds-calendar__nav",
        "Date Picker Header/navigation/date-picker_navigation*": ".ds-calendar__nav-button",
        "Date Grid Container": ".ds-calendar__grid-wrap",
        "Date Grid Container/Weekday Row Container": {
          "selector": ".ds-calendar__grid thead tr",
          "compare": "yh"
        },
        "Date Grid Container/Weekday Row Container/weekday row*": {
          "selector": ".ds-calendar__weekday",
          "compare": "xyw"
        },
        "Date Grid Container/Date Row Container*": {
          "selector": ".ds-calendar__grid tbody tr",
          "compare": "yh"
        },
        "Date Grid Container/Date Row Container*/date-picker_day*": ".ds-calendar__day",
        "day-text*": {
          "selector": ".ds-calendar__day-label",
          "compare": "xyh"
        }
      },
      "//": "Weekday names: Korean in Figma since 2026-10-19 (일 월 …, the locale the component uses) — compared",
      "//day-text": "day numbers are centred whole-pixel boxes; a 13.0x px number rounds up to 14 in the browser and 13 in Figma, so their width is not compared (position and glyphs are)"
    },
    {
      "set": "date-picker_day",
      "story": "components-calendar-showcase--day-matrix",
      "background": "#ffffff",
      "parts": {
        "Day Number": ".ds-calendar__day-label"
      }
    },
    {
      "set": "date-picker_navigation",
      "story": "components-calendar-showcase--navigation-matrix",
      "background": "#ffffff",
      "parts": {
        "caret-*": ".ds-calendar__nav-button > svg"
      }
    }
  ]
}
