{
  "component": "Slider",
  "sets": [
    {
      "set": "slider",
      "story": "components-slider-showcase--variant-matrix",
      "background": "#ffffff",
      "harnessCss": "table { table-layout: fixed; } td, th { width: 312px; min-width: 312px; max-width: 312px; } tr > :first-child { width: 120px; min-width: 120px; max-width: 120px; }",
      "parts": {
        "Track group": ".ds-slider__main",
        "Track group/Track control": ".ds-slider__track",
        "Track group/Track control/Track": ".ds-slider__rail",
        "Track group/Track control/Track/Indicator": {
          "selector": ".ds-slider__fill",
          "compare": "xyh"
        },
        "Track group/Track control/handle": {
          "selector": ".ds-slider__thumb",
          "compare": "ywh"
        },
        "Track group/Track control/handle/Handle": {
          "selector": ".ds-slider__knob",
          "compare": "ywh"
        },
        "Track group/Range labels": ".ds-slider__range",
        "Track group/Range labels/*": ".ds-slider__range-label",
        "Value input": {
          "selector": ".ds-slider__entry",
          "optional": true
        },
        "Value input/input": ".ds-slider__input",
        "Value input/input/Container": ".ds-slider__input .ds-field__control",
        "Value input/input/Container/Input": ".ds-slider__input .ds-field__input",
        "Value input/명": ".ds-slider__unit"
      },
      "maskPixels": [
        {
          "node": "Track group/Track control/handle",
          "pad": 4
        }
      ],
      "knownDifferences": {
        "State=Default": "the Figma handle is placed by hand 2px right of the fill end (x 93); the code centres it on the value (x 91) — x not compared, handle area masked",
        "State=Disabled": "same handle placement as Default"
      }
    },
    {
      "set": "handle",
      "story": "components-slider-showcase--handle-matrix",
      "background": "#ffffff",
      "harnessCss": "table { table-layout: fixed; } td { width: 44px; min-width: 44px; max-width: 44px; } th { width: 200px; min-width: 200px; max-width: 200px; }",
      "parts": {
        "Handle": ".ds-slider__knob",
        "Interaction ring": ".ds-slider__halo",
        "Value label": ".ds-slider__value-label",
        "Value label/Description Top": ".ds-slider__value-text"
      }
    }
  ]
}
