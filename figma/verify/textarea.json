{
  "component": "Textarea",
  "sets": [
    {
      "set": "textarea",
      "story": "components-textarea-showcase--variant-matrix",
      "background": "#ffffff",
      "harnessCss": "table { table-layout: fixed; } td, th { width: 344px; min-width: 344px; max-width: 344px; } tr > :first-child { width: 120px; min-width: 120px; max-width: 120px; }",
      "contentDependent": ["Character count/Character count container/*"],
      "//contentDependent": "Figma's counter digits (1 / 50 / 200) are mock values; the component shows the real length",
      "parts": {
        "Label row": ".ds-field__label-row",
        "Label row/Label": ".ds-field__label",
        "Container": ".ds-textarea__control",
        "Container/Input": { "selector": ".ds-textarea__input", "compare": "xyw" },
        "Character count": ".ds-textarea__footer",
        "Character count/textarea_message": { "selector": ".ds-field-message", "compare": "xyh" },
        "Character count/textarea_message/*-fill": ".ds-field-message__icon",
        "Character count/textarea_message/*ext": ".ds-field-message__text",
        "Character count/Character count container": { "selector": ".ds-textarea__count", "compare": "yh" }
      }
    }
  ]
}
