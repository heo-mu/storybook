{
  "name": "platform-design-system",
  "version": "0.1.0",
  "description": "React component library for the [Platform] Web Design System (Figma Ry3WecA6sP6lKPop1vXrTp, Ver 0.4)",
  "private": true,
  "type": "module",
  "main": "./dist/index.cjs",
  "module": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js",
      "require": "./dist/index.cjs"
    },
    "./styles.css": "./dist/styles.css",
    "./fonts.css": "./dist/fonts.css",
    "./tokens.css": "./dist/tokens/index.css",
    "./tokens/*": "./dist/tokens/*",
    "./package.json": "./package.json"
  },
  "files": [
    "dist"
  ],
  "sideEffects": [
    "**/*.css"
  ],
  "scripts": {
    "tokens": "node scripts/build-tokens.mjs",
    "figma:checksum": "node scripts/snapshot-checksum.mjs",
    "typecheck": "tsc -b",
    "build": "npm run tokens && tsc -b && vite build -c vite.lib.config.ts && tsc -p tsconfig.build.json && node scripts/copy-dist-assets.mjs",
    "lint": "oxlint",
    "test": "vitest run --project=storybook",
    "storybook": "storybook dev -p 6006",
    "build-storybook": "storybook build"
  },
  "peerDependencies": {
    "react": "^18.2.0 || ^19.0.0",
    "react-dom": "^18.2.0 || ^19.0.0"
  },
  "dependencies": {
    "pretendard": "^1.3.9"
  },
  "devDependencies": {
    "@storybook/addon-a11y": "^10.6.2",
    "@storybook/addon-docs": "^10.6.2",
    "@storybook/addon-mcp": "^10.6.2",
    "@storybook/addon-vitest": "^10.6.2",
    "@storybook/react-vite": "^10.6.2",
    "@types/node": "^24.13.3",
    "@types/react": "^19.2.18",
    "@types/react-dom": "^19.2.7",
    "@vitejs/plugin-react": "^6.1.1",
    "@vitest/browser-playwright": "^5.0.5",
    "@vitest/coverage-v8": "^5.0.5",
    "oxlint": "^1.81.0",
    "playwright": "^1.64.1",
    "storybook": "^10.6.2",
    "storybook-addon-pseudo-states": "^10.6.2",
    "typescript": "~6.0.2",
    "vite": "^8.3.0",
    "vitest": "^5.0.5",
    "react": "^19.2.8",
    "react-dom": "^19.2.8"
  }
}
